# 开饭后端环境变量模板
# 复制此文件为 .env 并填入真实值
# ⚠️  .env 已在 .gitignore 中，绝对不要提交到 git

# ===== MiniMax API 配置 =====
# 必填：去 https://platform.minimaxi.com/user-center/basic-information/secret-key 获取
MiniMax_API_KEY=your_api_key_here

# MiniMax API 端点（OpenAI 兼容）
MiniMax_BASE_URL=https://api.minimaxi.com/v1

# 文本/多模态模型（视觉+对话同一个）
# 统一用 MiniMax-M3（llm_client 已对所有调用关闭 thinking）
#   · M2.x thinking 无法关闭会拖慢 5-10×；M3 支持 disabled，同任务快 6-8 倍
MiniMax_TEXT_MODEL_MAIN=MiniMax-M3
MiniMax_TEXT_MODEL_TUTORIAL=MiniMax-M3

# 图像生成模型（已停用：生图改用 DashScope z-image-turbo，见下方）
# MiniMax_IMAGE_MODEL=image-01

# ===== 图片生成（z-image-turbo 主通道） =====
# 菜品配图主通道（MiniMax image-01 已停用）。
# 必填：去阿里云百炼 DashScope 控制台获取 https://bailian.console.aliyun.com/
# 留空则跳过生图，前端用占位图
DASHSCOPE_API_KEY=your_dashscope_api_key

# 生图 Mock：true 时不调真实 z-image-turbo，直接返回假 URL（端到端测试/演示用）
MOCK_IMAGE_GEN=false

# ===== HTTP 服务配置 =====
# CORS 白名单（多个 origin 用逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 业务配置
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=20971520

# ===== JWT 配置 =====
# 留空：main.py 启动时会自动生成并写入 .env
# 若生产环境多副本部署，必须显式配置同一份 JWT_SECRET（否则不同实例签发的 token 互不通用）
JWT_SECRET=
JWT_EXPIRE_DAYS=7
