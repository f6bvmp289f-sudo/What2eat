# 开饭后端环境变量模板
# 复制此文件为 .env 并填入真实值
# ⚠️  .env 已在 .gitignore 中，绝对不要提交到 git

# ===== MiniMax API 配置 =====
# 必填：去 https://platform.minimaxi.com/user-center/basic-information/secret-key 获取
MiniMax_API_KEY=your_api_key_here

# MiniMax API 端点（OpenAI 兼容）
MiniMax_BASE_URL=https://api.minimaxi.com/v1

# 文本/多模态模型（视觉+对话同一个）
# 文本模型（拆 main/tutorial 用途）
MiniMax_TEXT_MODEL_MAIN=MiniMax-M2.5-highspeed
MiniMax_TEXT_MODEL_TUTORIAL=MiniMax-M2.7-highspeed

# 图像生成模型
# 图像生成模型（image-01 真实摄影风格；image-01-live 更快但卡通风格）
MiniMax_IMAGE_MODEL=image-01

# ===== HTTP 服务配置 =====
# CORS 白名单（多个 origin 用逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 业务配置
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=20971520

# ===== JWT 配置 =====
# 留空：main.py 启动时会自动生成并写入 .env
# 若生产环境多副本部署，必须显式配置同一份 JWT_SECRET（否则不同实例签发的 token 互不通用）
JWT_SECRET=
JWT_EXPIRE_DAYS=7
